# Copia este archivo a .env y rellena los valores.

# URL pública donde corre la app (sin barra final). En local déjalo así:
BASE_URL=http://localhost:3000
PORT=3000

# Secreto para firmar las sesiones. Genera uno con:  openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-algo-aleatorio

# --- Stripe (opcional hasta que quieras cobrar) ---
# Saca las claves en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Crea un producto "Pro" con precio recurrente y pega aquí su price_id (price_...)
STRIPE_PRICE_ID=
# Secreto del webhook (https://dashboard.stripe.com/webhooks) apuntando a /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Carpeta donde se guarda la base de datos SQLite (en hosting usa un disco persistente)
# DATA_DIR=/data
